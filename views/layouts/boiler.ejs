<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StayScape</title>
    <!-- Bootstrap FIRST -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <!-- Your CSS AFTER (so it overrides Bootstrap) -->
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.25.0/mapbox-gl.css" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="icon" type="image" href="/image/logo.ico">
</head>

<body>
    <!-- loader -->
<div id="loader">
  <div class="loader-inner">
    <span>Stay</span><span class="loader-scape">Scape</span>
    <div class="loader-bar">
      <div class="loader-fill"></div>
    </div>
  </div>
</div>

    <!-- Navbar (only here, not in child files) -->
    <nav class="navbar">
        <a class="navbar-brand" href="/">
            <!-- <img src="/images/logo.png" alt="StayScape" class="navbar-logo-img"> -->
            Stay<span>Scape</span>
        </a>

        <form class="navbar-search" action="/listings" method="get">
            <input type="text" name="search" placeholder="Search destinations, places…"
                value="<%= typeof search !== 'undefined' ? search : '' %>" autocomplete="off">
            <button class="navbar-search-btn" type="submit">
                <i class="fa-solid fa-magnifying-glass" style="color:#ffffff"></i>
            </button>
        </form>

        <div class="navbar-actions">
            <button class="theme-toggle" id="themeToggle" title="Toggle dark mode">🌙</button>

            <% if (currUser) { %>
                <!-- Logged in -->
                <span class="navbar-user">👋 <%= currUser.username %></span>
                <form action="/logout" method="get">
                    <button class="btn btn-outline btn-sm">Log Out</button>
                </form>
                <% } else { %>
                    <!-- Not logged in -->
                    <a href="/signup" class="btn btn-outline btn-sm">Sign Up</a>
                    <a href="/login" class="btn btn-primary btn-sm">Log In</a>
                    <% } %>

                        <form action="/listings/new" method="get">
                            <button class="btn btn-primary btn-sm">+ New Listing</button>
                        </form>
        </div>
    </nav>

    <!-- Flash Messages -->
    <% if (success && success.length> 0) { %>
        <div class="flash-container">
            <div class="flash flash-success" id="flashMsg">
                <span class="flash-icon">✅</span>
                <span class="flash-text">
                    <%= success %>
                </span>
                <button class="flash-close" onclick="this.parentElement.parentElement.remove()">✕</button>
            </div>
        </div>
        <% } %>
            <% if (error && error.length> 0) { %>
                <div class="flash-container">
                    <div class="flash flash-error" id="flashMsg">
                        <span class="flash-icon">❌</span>
                        <span class="flash-text">
                            <%= error %>
                        </span>
                        <button class="flash-close" onclick="this.parentElement.parentElement.remove()">✕</button>
                    </div>
                </div>
                <% } %>

                    <!-- Page Content -->
                    <main>
                        <%- body %>
                    </main>

                    <!-- Footer -->
                    <footer class="footer">
                        &copy; 2026 <a href="/listings">StayScape</a>. All rights reserved.
                    </footer>

                    <!-- Scripts (only here, not in child files) -->
                    <script src="https://kit.fontawesome.com/04ea02bc57.js" crossorigin="anonymous"></script>
                    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                        crossorigin="anonymous"></script>
                    <%- include("../includes/darkscript.ejs") %>
                        <script src="/js/script.js"></script>
                        <script>
                            function togglePassword(fieldId, btn) {
                                const input = document.getElementById(fieldId);
                                const icon = btn.querySelector('i');
                                if (input.type === 'password') {
                                    input.type = 'text';
                                    icon.classList.replace('fa-eye', 'fa-eye-slash');
                                } else {
                                    input.type = 'password';
                                    icon.classList.replace('fa-eye-slash', 'fa-eye');
                                }
                            }
                        </script>
                        <!-- Flash auto dismiss -->
                        <script>
                            setTimeout(() => {
                                const flash = document.getElementById('flashMsg');
                                if (flash) {
                                    flash.style.animation = 'fadeOut 0.5s ease forwards';
                                    setTimeout(() => flash?.parentElement?.remove(), 1000);
                                }
                            }, 5000);
                        </script>
                        <!-- Page specific scripts -->
                        <%- block('scripts') %>
                        <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
                        <script>
    AOS.init({
        once:true,
    });
</script>
<script>
  // hide loader when page is ready
  window.addEventListener('load', function() {
    // wait at least 2.5s before hiding
    setTimeout(function() {
      var loader = document.getElementById('loader');
      loader.style.opacity = '0';
      setTimeout(function() {
        loader.style.display = 'none';
      }, 500); // fade out takes 0.5s
    }, 700);
  });
</script>

</body>

</html>